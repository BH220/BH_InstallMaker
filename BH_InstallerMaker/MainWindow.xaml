<Window
    x:Class="BH_InstallerMaker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BH_InstallerMaker"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BH_InstallerMaker.ViewModels"
    Title="BH Installer Maker"
    Width="1064"
    Height="748"
    MinWidth="1064"
    MinHeight="748"
    d:DataContext="{d:DesignInstance Type=vm:MakerViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI, Malgun Gothic"
    TextOptions.TextFormattingMode="Display"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="8"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!--  필드 라벨  -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <!--  섹션 카드  -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,14,18,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!--  섹션 제목  -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        </Style>
        <!--  인증서 검사 결과 문구. 유효하면 초록으로 표시  -->
        <Style
            x:Key="CertInfo"
            BasedOn="{StaticResource Text.Caption}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCertValid}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border
        x:Name="RootBorder"
        Margin="12"
        Background="{StaticResource Brush.WindowBg}"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Opacity="0.28"
                ShadowDepth="2" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <!--  타이틀바  -->
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel
                    Margin="22,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="26"
                        Height="26"
                        Background="{StaticResource Brush.AccentGradient}"
                        CornerRadius="7">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="BH" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        Text="BH Installer Maker" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{StaticResource Brush.TextTertiary}"
                        Text="설치 · 삭제 · 런처 빌드 도구" />
                </StackPanel>
                <StackPanel
                    Margin="0,9,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <Button
                        Click="BtnMinimize_Click"
                        Content="&#xE921;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource Btn.Chrome}" />
                    <Button
                        x:Name="BtnMaximize"
                        Click="BtnMaximize_Click"
                        Content="&#xE922;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource Btn.Chrome}" />
                    <Button
                        Click="BtnClose_Click"
                        Content="✕"
                        Style="{StaticResource Btn.ChromeClose}" />
                </StackPanel>
            </Grid>

            <!--  본문 : 좌측 입력 / 우측 로그  -->
            <Grid Grid.Row="1" Margin="24,4,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="470" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 좌측 : 입력 =====  -->
                <ScrollViewer Padding="0,0,6,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!--  배포 소스  -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="배포 소스" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="프로젝트 파일 (.csproj)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        IsReadOnly="True"
                                        Style="{StaticResource Tb.Modern}"
                                        Text="{Binding ProjectPath, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="14,0"
                                        Command="{Binding BrowseProjectCommand}"
                                        Content="찾아보기"
                                        Style="{StaticResource Btn.Secondary}" />
                                </Grid>
                                <TextBlock
                                    Margin="0,7,0,0"
                                    Style="{StaticResource Text.Caption}"
                                    Text="{Binding ProjectSummary}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!--  프로그램 정보  -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="프로그램 정보" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="프로그램 이름" />
                                        <TextBox Style="{StaticResource Tb.Modern}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="버전 (자동)" />
                                        <TextBox Style="{StaticResource Tb.Modern}" Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="제작자" />
                                <TextBox Style="{StaticResource Tb.Modern}" Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="설명" />
                                <TextBox
                                    Height="60"
                                    Padding="0,8"
                                    AcceptsReturn="True"
                                    Style="{StaticResource Tb.Modern}"
                                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalContentAlignment="Top"
                                    VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <!--  설치 경로  -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="설치 경로" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="프로그램 설치 경로 (RootPath)" />
                                <TextBox Style="{StaticResource Tb.Modern}" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="데이터 저장 경로 (DataRootPath)" />
                                <TextBox Style="{StaticResource Tb.Modern}" Text="{Binding DataRootPath, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="레지스트리 키 (HKEY_LOCAL_MACHINE 하위)" />
                                <TextBox Style="{StaticResource Tb.Modern}" Text="{Binding RegistryKey, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource Text.Caption}"
                                    Text="예: SOFTWARE\회사명\프로그램명" />
                            </StackPanel>
                        </Border>

                        <!--  Windows 서비스  -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionTitle}"
                                        Text="Windows 서비스" />
                                    <CheckBox
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Content="서비스로 등록"
                                        IsChecked="{Binding UseWindowsService}"
                                        Style="{StaticResource Chk.Modern}" />
                                </Grid>

                                <StackPanel Visibility="{Binding UseWindowsService, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="서비스 이름 (영문, 띄어쓰기 없음)" />
                                    <TextBox Style="{StaticResource Tb.Modern}" Text="{Binding WindowsServiceName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="서비스 설명" />
                                    <TextBox Style="{StaticResource Tb.Modern}" Text="{Binding WindowsServiceDescription, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  라이선스  -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionTitle}"
                                        Text="라이선스" />
                                    <CheckBox
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Content="라이선스 인증 사용"
                                        IsChecked="{Binding UseLicense}"
                                        Style="{StaticResource Chk.Modern}" />
                                </Grid>

                                <StackPanel Visibility="{Binding UseLicense, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="프로그램 ID (DB)" />
                                    <TextBox
                                        Width="130"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource Tb.Modern}"
                                        Text="{Binding ProgramIdText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  코드 서명  -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionTitle}"
                                        Text="코드 서명" />
                                    <CheckBox
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Content="게시 결과물에 서명"
                                        IsChecked="{Binding UseCodeSigning}"
                                        Style="{StaticResource Chk.Modern}" />
                                </Grid>

                                <StackPanel Visibility="{Binding UseCodeSigning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="인증서 파일 (.pfx)" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource Tb.Modern}" Text="{Binding PfxPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="14,0"
                                            Command="{Binding BrowsePfxCommand}"
                                            Content="찾아보기"
                                            Style="{StaticResource Btn.Secondary}" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="PFX 암호 (저장되지 않음)" />
                                    <PasswordBox
                                        x:Name="PfxPasswordBox"
                                        PasswordChanged="PfxPasswordBox_PasswordChanged"
                                        Style="{StaticResource Pw.Modern}" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="타임스탬프 서버 (RFC 3161)" />
                                    <TextBox Style="{StaticResource Tb.Modern}" Text="{Binding TimestampUrl, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource CertInfo}"
                                        Text="{Binding CertInfoText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!--  ===== 우측 : 빌드 로그 =====  -->
                <Border
                    Grid.Column="2"
                    Margin="0,0,0,12"
                    Background="{StaticResource Brush.Card}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="18,14,18,10">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionTitle}"
                                Text="빌드 로그" />
                            <Button
                                Height="28"
                                Padding="12,0"
                                HorizontalAlignment="Right"
                                Command="{Binding ClearLogCommand}"
                                Content="지우기"
                                FontSize="11.5"
                                Style="{StaticResource Btn.Secondary}" />
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Margin="18,0,18,16"
                            Padding="12,8"
                            Background="{StaticResource Brush.InputBg}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Logs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,1.5"
                                                FontFamily="Consolas"
                                                FontSize="11.5"
                                                Foreground="{StaticResource Brush.TextSecondary}"
                                                Text="{Binding}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!--  하단 바  -->
            <Border
                Grid.Row="2"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0">
                <Grid Margin="24,0">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource Brush.TextSecondary}"
                        Text="{Binding StatusText}" />
                    <Button
                        MinWidth="150"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding BuildCommand}"
                        Content="{Binding BuildButtonText}"
                        Style="{StaticResource Btn.Primary}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
