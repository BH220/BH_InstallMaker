<Window
    x:Class="BH_Uninstall.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BH_Uninstall"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BH_Uninstall.ViewModels"
    Title="프로그램 제거"
    Width="664"
    Height="500"
    d:DataContext="{d:DesignInstance Type=vm:UninstallViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI, Malgun Gothic"
    Icon="main_icon.ico"
    ResizeMode="NoResize"
    TextOptions.TextFormattingMode="Display"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border
        Margin="12"
        Background="{StaticResource Brush.WindowBg}"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Opacity="0.28"
                ShadowDepth="2" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <!--  타이틀바  -->
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource Brush.TextTertiary}"
                    Text="프로그램 제거" />
                <StackPanel
                    Margin="0,6,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <Button
                        Click="BtnMinimize_Click"
                        Content="&#xE921;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource Btn.Chrome}" />
                    <Button
                        Click="BtnClose_Click"
                        Content="✕"
                        Style="{StaticResource Btn.ChromeClose}" />
                </StackPanel>
            </Grid>

            <!--  헤더 : 아이콘 + 프로그램 정보  -->
            <StackPanel
                Grid.Row="1"
                Margin="40,6,40,0"
                Orientation="Horizontal">
                <Border
                    Width="52"
                    Height="52"
                    Background="#FDECEC"
                    CornerRadius="14">
                    <Path
                        Width="24"
                        Height="24"
                        Data="M9,3 L15,3 L15,5 L20,5 L20,7 L4,7 L4,5 L9,5 Z M6,9 L18,9 L17,21 L7,21 Z"
                        Fill="{StaticResource Brush.Danger}"
                        Stretch="Uniform" />
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        Text="{Binding ProgramName}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="12"
                        Foreground="{StaticResource Brush.TextSecondary}"
                        Text="{Binding ProgramSub}" />
                </StackPanel>
            </StackPanel>

            <!--  화면들  -->
            <Grid Grid.Row="2" Margin="40,20,40,0">

                <!--  1) 확인  -->
                <Grid x:Name="PanelConfirm">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding ConfirmText}" />

                        <Border
                            Margin="0,16,0,0"
                            Padding="18,14"
                            Background="#FDF1F1"
                            BorderBrush="#F5D5D6"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource Brush.Danger}"
                                    CornerRadius="10">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="!" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    FontSize="12.5"
                                    Foreground="#8A3A3E"
                                    LineHeight="20"
                                    Text="프로그램 파일, 레지스트리, 바로 가기, Windows 서비스, 다운로드한 파일과 사용자 데이터가 모두 삭제되며 되돌릴 수 없습니다."
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <TextBlock
                            Margin="0,16,0,0"
                            Style="{StaticResource Text.Caption}"
                            Text="계속하려면 [제거]를 누르세요." />
                    </StackPanel>
                </Grid>

                <!--  2) 진행  -->
                <Grid x:Name="PanelProgress" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding StageText}" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,14,0,8"
                            FontSize="34"
                            FontWeight="Bold"
                            Foreground="{StaticResource Brush.Danger}"
                            Text="{Binding PercentText}" />

                        <ProgressBar
                            Grid.Row="2"
                            Foreground="{StaticResource Brush.DangerGradient}"
                            Maximum="100"
                            Style="{StaticResource Pb.Modern}"
                            Value="{Binding Percent, Mode=OneWay}" />

                        <Border
                            Grid.Row="3"
                            Margin="0,16,0,4"
                            Padding="14,10"
                            Background="{StaticResource Brush.Card}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Logs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,2"
                                                FontFamily="Consolas"
                                                FontSize="11.5"
                                                Foreground="{StaticResource Brush.TextSecondary}"
                                                Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!--  3) 완료  -->
                <Grid x:Name="PanelDone" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border
                            Width="76"
                            Height="76"
                            HorizontalAlignment="Center"
                            Background="{StaticResource Brush.SuccessSoft}"
                            CornerRadius="38">
                            <Path
                                Data="M20,39 L33,52 L57,26"
                                Stroke="{StaticResource Brush.Success}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="5" />
                        </Border>
                        <TextBlock
                            Margin="0,22,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Text.Title}"
                            Text="제거가 완료되었습니다" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Text.Subtitle}"
                            Text="{Binding DoneSubText}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!--  하단 버튼  -->
            <Border
                Grid.Row="3"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0">
                <Grid Margin="40,0">
                    <Button
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding CancelCommand}"
                        Content="취소"
                        Style="{StaticResource Btn.Secondary}"
                        Visibility="{Binding IsCancelVisible, Converter={StaticResource BoolToVis}}" />
                    <Button
                        x:Name="BtnAction"
                        MinWidth="110"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding ActionCommand}"
                        Content="{Binding ActionLabel}"
                        IsEnabled="{Binding IsActionEnabled}"
                        Style="{StaticResource Btn.Danger}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
