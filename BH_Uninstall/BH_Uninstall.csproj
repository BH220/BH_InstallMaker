<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>_0049_Trash.ico</ApplicationIcon>
    <!-- 관리자 권한 요구. 설치 폴더 갱신·HKLM·서비스 제어에 필요하다. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 코드 서명 시 UAC 대화상자에 표시될 이름 -->
    <BH_SignDescription>BH Soft Uninstaller</BH_SignDescription>
  </PropertyGroup>

  <!-- 창 아이콘. Window.Icon="/_0049_Trash.ico" 가 pack URI 로 찾으므로 Resource 여야 하고, 단일 파일 게시에도 exe 안에 들어간다 -->
  <ItemGroup>
    <Resource Include="_0049_Trash.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BH_Install.Core\BH_Install.Core.csproj" />
  </ItemGroup>

  <!-- 게시 폴더 초기화, pdb 제외, 게시 후 코드 서명 등 공용 게시 규칙 -->
  <Import Project="..\BH.Publish.targets" />

</Project>