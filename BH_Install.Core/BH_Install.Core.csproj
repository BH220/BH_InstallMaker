<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- 루트 CA 공개키를 어셈블리에 내장한다.
       별도 파일로 배포하지 않으므로 배포 중 누락이나 교체 위험이 없다.
       LogicalName 은 CertificateInstaller.RootCertResourceName 과 일치해야 한다. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\BHSoft-RootCA.cer" LogicalName="BH_Install.Core.Resources.BHSoft_RootCA.cer" />
  </ItemGroup>
  <!-- 프로그램 매니페스트. 메이커가 ProgramManifest.SaveToModel() 로 이 파일을 덮어쓴 뒤 모듈을 게시한다.
       LogicalName 을 지정하지 않으면 리소스 이름이 BH_Install.Core.ProgramModel.json 이 되어 코드의 ResourceName 과 어긋난다. -->
  <ItemGroup>
    <EmbeddedResource Include="ProgramModel.json" LogicalName="ProgramModel.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
