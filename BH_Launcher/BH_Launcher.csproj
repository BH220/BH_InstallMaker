<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AppVersion>1.0.0.1</AppVersion>
		<AssemblyVersion>$(AppVersion)</AssemblyVersion>
		<FileVersion>$(AppVersion)</FileVersion>
		<InformationalVersion>$(AppVersion)</InformationalVersion>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<!-- 관리자 권한 요구. 설치 폴더 갱신·HKLM·서비스 제어에 필요하다. -->
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- 코드 서명 시 UAC 대화상자에 표시될 이름 -->
		<BH_SignDescription>BH Soft Launcher</BH_SignDescription>
	</PropertyGroup>


	<ItemGroup>
		<None Remove="main_icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BH_Install.Core\BH_Install.Core.csproj" />
	</ItemGroup>

	<!-- 런처 exe 아이콘(탐색기·바로 가기). 메이커가 -p:BH_LauncherIcon=<대상 .ico> 로 넘기고, 없으면(F5) 기본 아이콘.
       창·작업 표시줄 아이콘과 좌상단 로고는 Core 의 ProgramIcon.ico 리소스(매니페스트 MainIcon)를 쓴다.
       예전처럼 대상 .ico 를 Link 로 리소스에 넣으면, 그 파일의 수정 시각이 오래되어 증분 빌드가 리소스를 다시 만들지 않아 옛 아이콘이 남는다. -->
	<PropertyGroup>
		<BH_LauncherIcon Condition="'$(BH_LauncherIcon)' == ''">main_icon.ico</BH_LauncherIcon>
		<ApplicationIcon>$(BH_LauncherIcon)</ApplicationIcon>
	</PropertyGroup>
	<ItemGroup>
		<!-- Core 아이콘을 못 읽을 때의 로고 대체 이미지 -->
		<Resource Include="main_icon.ico" />
	</ItemGroup>

	<!-- 게시 폴더 초기화, pdb 제외, 게시 후 코드 서명 등 공용 게시 규칙 -->
	<Import Project="..\BH.Publish.targets" />

</Project>