<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>main_icon.ico</ApplicationIcon>
    <!-- 관리자 권한 요구. 루트 인증서 설치와 HKLM 등록에 필요하다. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 코드 서명 시 UAC 대화상자에 표시될 이름 -->
    <BH_SignDescription>BH Soft Installer</BH_SignDescription>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\BH_Launcher.exe" />
    <None Remove="Resources\BH_Uninstall.exe" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\BH_Launcher.exe" />
    <EmbeddedResource Include="Resources\BH_Uninstall.exe" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BH_Install.Core\BH_Install.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="main_icon.ico" />
  </ItemGroup>

  <!-- 메이커가 게시할 때 서명된 런처·언인스톨 exe 를 페이로드로 임베드한다.
       -p:BH_LauncherExe=<경로> -p:BH_UninstallExe=<경로>
       설치 프로그램은 PayloadResource.Extract() 로 설치 폴더에 꺼낸다. LogicalName 은 PayloadResource 의 상수와 같아야 한다. -->
  <ItemGroup Condition="'$(BH_LauncherExe)' != ''">
    <EmbeddedResource Include="$(BH_LauncherExe)" LogicalName="BH.payload.BH_Launcher.exe" />
  </ItemGroup>
  <ItemGroup Condition="'$(BH_UninstallExe)' != ''">
    <EmbeddedResource Include="$(BH_UninstallExe)" LogicalName="BH.payload.BH_Uninstall.exe" />
  </ItemGroup>

  <!-- 게시 폴더 초기화, pdb 제외, 게시 후 코드 서명 등 공용 게시 규칙 -->
  <Import Project="..\BH.Publish.targets" />

</Project>