<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>main_icon.ico</ApplicationIcon>
    <!-- 관리자 권한 요구. 루트 인증서 설치와 HKLM 등록에 필요하다. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 코드 서명 시 UAC 대화상자에 표시될 이름 -->
    <BH_SignDescription>BH Soft Installer</BH_SignDescription>
  </PropertyGroup>

  <!-- 설치 프로그램에 들어가는 런처·언인스톨 exe (페이로드). 메이커(ModuleBuilder)가 게시 직전에 서명된 최신 빌드본으로 덮어쓴다.
       리소스 이름은 BH_Install.Resources.BH_Launcher.exe 형식이며 PayloadResource.Extract() 가 그 이름으로 꺼낸다.
       F5 실행을 위해 파일은 항상 있어야 하지만, 여기 들어 있는 내용은 빌드 산출물이라 배포 결과와 무관하다. -->
  <ItemGroup>
    <None Remove="Resources\BH_Launcher.exe" />
    <None Remove="Resources\BH_Uninstall.exe" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\BH_Launcher.exe" />
    <EmbeddedResource Include="Resources\BH_Uninstall.exe" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BH_Install.Core\BH_Install.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="main_icon.ico" />
  </ItemGroup>

  <!-- 게시 폴더 초기화, pdb 제외, 게시 후 코드 서명 등 공용 게시 규칙 -->
  <Import Project="..\BH.Publish.targets" />

</Project>